{
  "schema_version": 2,
  "default": "huejotzingo",
  "evaluation_policy": {
    "stages": {
      "metadata": {
        "purpose": "eligibility gate only",
        "fields": [
          "license",
          "downloadability",
          "duration_seconds",
          "resolution"
        ]
      },
      "preflight": {
        "purpose": "measure whether the video itself is suitable for SfM and 3DGS",
        "fields": [
          "scene_cut_count",
          "sharp_frame_ratio",
          "adjacent_view_overlap",
          "camera_translation_proxy",
          "dynamic_pixel_ratio",
          "exposure_variation"
        ]
      },
      "colmap": {
        "purpose": "measure camera-pose and sparse-reconstruction stability",
        "fields": [
          "registered_images",
          "input_images",
          "registration_ratio",
          "largest_model_ratio",
          "submodel_count",
          "sparse_points",
          "mean_reprojection_error_px",
          "mean_track_length"
        ]
      },
      "splat": {
        "purpose": "measure the actual Gaussian Splat result",
        "fields": [
          "train_success",
          "export_success",
          "holdout_psnr",
          "holdout_ssim",
          "holdout_lpips",
          "ply_sha256",
          "ply_size_bytes"
        ]
      }
    },
    "principle": "Do not assign reconstruction scores from metadata. Rank only from measured results, and compare sources at the same evaluation stage."
  },
