#!/usr/bin/env bash
set -euo pipefail

uv lock --check
uv export --frozen --no-dev --format requirements-txt --output-file /tmp/autophotogrammetry-requirements.txt
diff -u requirements.txt /tmp/autophotogrammetry-requirements.txt
uv run ruff format --check .
uv run ruff check .
uv run pyrefly check
bash -n task
uv run python -m py_compile main.py processing/*.py tests/*.py
